@CadastroPessoas.Api_HostAddress = http://localhost:5297

### Cadastrar pessoa
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas
Content-Type: application/json

{
  "nome": "Maria Silva",
  "cpf": "12345678909",
  "dataNascimento": "1990-05-15",
  "ativo": true
}

### Listar todas
GET {{CadastroPessoas.Api_HostAddress}}/api/pessoas

### Buscar por id
GET {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1

### Buscar inexistente (esperado: 404)
GET {{CadastroPessoas.Api_HostAddress}}/api/pessoas/999

### Atualizar pessoa (esperado: 204)
PUT {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1
Content-Type: application/json

{
  "nome": "Maria Souza",
  "cpf": "12345678909",
  "dataNascimento": "1990-05-15",
  "ativo": false
}

### Atualizar inexistente (esperado: 404)
PUT {{CadastroPessoas.Api_HostAddress}}/api/pessoas/999
Content-Type: application/json

{
  "nome": "Ninguem",
  "cpf": "00000000000",
  "dataNascimento": "2000-01-01",
  "ativo": true
}

### Remover pessoa (esperado: 204)
DELETE {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1

### Remover inexistente (esperado: 404)
DELETE {{CadastroPessoas.Api_HostAddress}}/api/pessoas/999

### Cadastrar sem nome (esperado: 400)
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas
Content-Type: application/json

{
  "nome": "",
  "cpf": "12345678909",
  "dataNascimento": "1990-05-15",
  "ativo": true
}

### Cadastrar com CPF curto (esperado: 400)
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas
Content-Type: application/json

{
  "nome": "Joao Pereira",
  "cpf": "123",
  "dataNascimento": "1985-03-20",
  "ativo": true
}

### Cadastrar com data no futuro (esperado: 400)
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas
Content-Type: application/json

{
  "nome": "Ana Costa",
  "cpf": "98765432100",
  "dataNascimento": "2099-01-01",
  "ativo": true
}

### Cadastrar pessoa com telefones (esperado: 201)
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas
Content-Type: application/json

{
  "nome": "Carlos Lima",
  "cpf": "11122233344",
  "dataNascimento": "1980-07-10",
  "ativo": true,
  "telefones": [
    { "tipo": "Celular", "numero": "43999998888" },
    { "tipo": "Comercial", "numero": "4332551234" }
  ]
}

### Listar telefones da pessoa (esperado: 200)
GET {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1/telefones

### Buscar telefone por id (esperado: 200)
GET {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1/telefones/1

### Adicionar telefone (esperado: 201)
POST {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1/telefones
Content-Type: application/json

{
  "tipo": "Residencial",
  "numero": "4332559999"
}

 ### Atualizar telefone (esperado: 204)
PUT {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1/telefones/1
Content-Type: application/json

{
  "tipo": "Celular",
  "numero": "43988887777"
}

### Remover telefone (esperado: 204)
DELETE {{CadastroPessoas.Api_HostAddress}}/api/pessoas/1/telefones/2